diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index f102b56..1cdbbcd 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -702,3 +702,36 @@ set_target_properties(libavutil libavcodec PROPERTIES
     C_VISIBILITY_PRESET hidden
     VISIBILITY_INLINES_HIDDEN ON
     FOLDER "FFmpeg")
+
+# Bionic does not provide the ucontext family - Android removed getcontext,
+# setcontext, makecontext and swapcontext from libc - so src/core/fiber_posix.cpp
+# has nothing to call. libucontext supplies them in aarch64 assembly, and its
+# .S files already ALIAS the plain names onto their libucontext_ prefixed ones,
+# so the fiber backend links unmodified.
+if(ANDROID)
+    enable_language(ASM)
+    if(NOT CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a")
+        message(FATAL_ERROR
+            "libucontext is wired up for arm64-v8a only; add the matching "
+            "thirdparty/libucontext/arch/<arch> sources for ${CMAKE_ANDROID_ARCH_ABI}.")
+    endif()
+    add_library(ucontext STATIC
+        libucontext/arch/aarch64/getcontext.S
+        libucontext/arch/aarch64/setcontext.S
+        libucontext/arch/aarch64/swapcontext.S
+        libucontext/arch/aarch64/makecontext.c
+        libucontext/arch/aarch64/trampoline.c)
+    target_include_directories(ucontext PUBLIC
+        libucontext/include
+        libucontext/arch/aarch64/include)
+    target_include_directories(ucontext PRIVATE
+        libucontext/arch/aarch64
+        libucontext/arch/common)
+    # Without this the .S files only define the libucontext_ prefixed names;
+    # the ALIAS macro that also emits plain getcontext/setcontext/makecontext/
+    # swapcontext is compiled out. Those plain names are the whole point here,
+    # since fiber_posix.cpp calls them unmodified.
+    target_compile_definitions(ucontext PRIVATE EXPORT_UNPREFIXED)
+    target_compile_options(ucontext PRIVATE -w)
+    set_target_properties(ucontext PROPERTIES POSITION_INDEPENDENT_CODE ON FOLDER "thirdparty")
+endif()
