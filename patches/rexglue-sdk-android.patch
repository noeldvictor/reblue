diff --git a/include/rex/main_android.h b/include/rex/main_android.h
new file mode 100644
index 0000000..ee0f220
--- /dev/null
+++ b/include/rex/main_android.h
@@ -0,0 +1,28 @@
+#pragma once
+/**
+ * @file    rex/main_android.h
+ * @brief   The sliver of Xenia's Android app module ReXGlue actually uses.
+ *
+ * threading_posix.cpp and memory_posix.cpp both call rex::GetAndroidApiLevel()
+ * to decide whether API 26+ symbols are worth dlsym-ing, and both include this
+ * header, but it never made it across from Xenia. Xenia's version carried a
+ * whole Activity lifecycle; the API level is the only part anything here wants.
+ *
+ * @modified re:Blue fork, 2026
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+
+#include <android/api-level.h>
+
+namespace rex {
+
+// bionic has provided this since API 29, which is already our minimum, so
+// there is no need for Xenia's cached-at-startup value.
+inline int GetAndroidApiLevel() { return android_get_device_api_level(); }
+
+}  // namespace rex
+
+#endif  // REX_PLATFORM_ANDROID
diff --git a/include/rex/thread/fiber.h b/include/rex/thread/fiber.h
index 352af67..2941590 100644
--- a/include/rex/thread/fiber.h
+++ b/include/rex/thread/fiber.h
@@ -23,6 +23,30 @@
 #include <ucontext.h>
 #include <cstdint>
 #include <vector>
+
+#if defined(__ANDROID__)
+// Bionic still ships <ucontext.h> and ucontext_t for signal handlers, but
+// Android removed the ucontext family itself from libc. thirdparty/libucontext
+// supplies them in aarch64 assembly and its .S files alias the plain names, so
+// only the declarations are missing here.
+#include <cstddef>
+extern "C" {
+int getcontext(ucontext_t *);
+int setcontext(const ucontext_t *);
+void makecontext(ucontext_t *, void (*)(), int, ...);
+int swapcontext(ucontext_t *, const ucontext_t *);
+}
+// libucontext's aarch64 assembly hardcodes these offsets into ucontext_t. If
+// bionic ever lays the struct out differently, the assembly would quietly read
+// and write the wrong registers - a corrupted fiber switch, which is about the
+// worst thing to debug at runtime. Fail the build instead.
+static_assert(offsetof(ucontext_t, uc_mcontext.regs) == 184,
+              "libucontext aarch64 MCONTEXT_GREGS offset disagrees with bionic");
+static_assert(offsetof(ucontext_t, uc_mcontext.sp) == 432,
+              "libucontext aarch64 SP_OFFSET disagrees with bionic");
+static_assert(offsetof(ucontext_t, uc_mcontext.pc) == 440,
+              "libucontext aarch64 PC_OFFSET disagrees with bionic");
+#endif
 #endif
 
 namespace rex::thread {
