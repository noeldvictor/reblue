diff --git a/src/core/filesystem_android.cpp b/src/core/filesystem_android.cpp
new file mode 100644
index 0000000..929ced6
--- /dev/null
+++ b/src/core/filesystem_android.cpp
@@ -0,0 +1,47 @@
+/**
+ * @file    src/core/filesystem_android.cpp
+ * @brief   The Android-only pieces of rex::filesystem.
+ *
+ * @modified re:Blue fork, 2026
+ */
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+
+#include <string_view>
+
+#include <rex/filesystem.h>
+
+namespace rex::filesystem {
+
+// Declared in rex/filesystem.h and called by mapped_memory_posix.cpp, but never
+// defined - another piece that did not survive the crossing from Xenia, whose
+// version JNI-called into Java to resolve a content:// URI to a file
+// descriptor.
+//
+// Nothing in this fork needs it: game data is side-loaded to an ordinary path
+// under the app's external files directory rather than picked through the
+// Storage Access Framework. The one caller already treats a negative return as
+// "could not open" and falls back, so a stub is a correct implementation of
+// "content URIs are not supported here" rather than a hole.
+//
+// If a SAF-based import flow is ever added, this is where it goes, and it will
+// need a JNIEnv and a reference to the Activity.
+int OpenAndroidContentFileDescriptor(const std::string_view uri, const char* mode) {
+  (void)uri;
+  (void)mode;
+  return -1;
+}
+
+// Declared in rex/filesystem.h and, like the function above, never defined.
+// Xenia's versions cached a JNI reference to the content resolver so that
+// content:// URIs could be opened later. Nothing here uses content URIs, so
+// there is nothing to set up or tear down - but the symbols have to exist,
+// because the Android startup path calls all three subsystems' initialisers
+// together.
+void AndroidInitialize() {}
+void AndroidShutdown() {}
+
+}  // namespace rex::filesystem
+
+#endif  // REX_PLATFORM_ANDROID
