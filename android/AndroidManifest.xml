<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.reblue"
    android:versionCode="1"
    android:versionName="1.0.0">

    <!-- 29 is the floor the native build targets. Quest 2 reports 32, the
         AYN Thor 33. -->
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="33" />

    <uses-feature android:name="android.hardware.vulkan.version" android:required="true" />
    <!-- Headtracking not required: the same APK still runs as a 2D panel on a
         handheld like the AYN Thor, which has no headset at all. -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="false" />

    <!-- The OpenXR loader finds the active runtime through a content provider,
         and Android 11+ package visibility hides it unless it is queried for.
         Without this the loader reports no runtime and the app silently stays
         flat. -->
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
    </queries>
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Game data is side-loaded rather than imported through the Storage
         Access Framework; see the content-URI stub in the SDK patch. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="re:Blue"
        android:allowBackup="false"
        android:hasCode="true"
        android:extractNativeLibs="true">

        <activity
            android:name="com.reblue.ReblueActivity"
            android:exported="true"
            android:label="re:Blue"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Makes Horizon OS launch this immersively rather than as a
                     flat panel. The session itself is still gated behind
                     bd_vr_enabled, so this only changes how the app is
                     presented, not whether it opens a runtime session. -->
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
